# Server-side only. Get a key at https://typesafe.ai
TYPESAFE_API_KEY=
# Optional: how many top blocks to explore at level 2 (default 1). Each extra block costs one more 255-option question per keystroke.
JEV_FANOUT=1
# Optional: price you pay per million input tokens, used only for the cost readout in the UI (e.g. 0.50)
NEXT_PUBLIC_JEV_PRICE_PER_M_INPUT_TOKENS=
# Optional: cap on blocks a visitor may open at level 2 (default 5) and per-visitor requests per 10 seconds (default 40)
JEV_MAX_FANOUT=5
JEV_RATE_LIMIT=40
