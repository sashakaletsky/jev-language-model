# Server-side only. Get a key at https://typesafe.ai
TYPESAFE_API_KEY=
# Optional: how many top blocks to open at level 2 (default 10). Each extra block costs one more 255-option question per keystroke.
JEV_FANOUT=10
# Optional: sampling temperature for the suggestion (default 0.8). 0 always suggests the top candidate.
JEV_TEMPERATURE=0.8
# Optional: price you pay per million input tokens, used only for the cost readout in the UI (e.g. 0.50)
NEXT_PUBLIC_JEV_PRICE_PER_M_INPUT_TOKENS=
# Optional: cap on blocks a visitor may open at level 2 (default 12) and per-visitor requests per 10 seconds (default 40)
JEV_MAX_FANOUT=12
JEV_RATE_LIMIT=40
